# MongoDB Atlas (replica set needed for transactions). Use a UAE / nearby region.
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=healthos_prod
# Random, 32+ characters:  openssl rand -hex 32
AUTH_SECRET=
# Public URL of the app, e.g. https://elister.devxpert.ae
BETTER_AUTH_URL=
# Extra allowed origins (comma separated), e.g. the *.vercel.app URL
TRUSTED_ORIGINS=
# 32 random bytes, base64:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
FIELD_ENCRYPTION_KEY=
# Keys for the public queue display and the QR kiosk
DISPLAY_KEY=
KIOSK_KEY=
